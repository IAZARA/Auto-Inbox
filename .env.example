GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
VITE_GOOGLE_OAUTH_CLIENT_ID=

# AI provider: openai | deepseek | anthropic | moonshot | custom-openai-compatible
AI_PROVIDER=openai
AI_MODEL=gpt-5-mini
AI_API_KEY=
AI_BASE_URL=
AI_JSON_MODE=

# Provider-specific alternatives. You can use these instead of AI_API_KEY / AI_MODEL.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
MOONSHOT_API_KEY=
MOONSHOT_MODEL=kimi-k2.6

VITE_GMAIL_SYNC_INTERVAL_SECONDS=90
